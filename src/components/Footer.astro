---
import {
	ICP_LICENSE,
	ICP_LICENSE_URL,
	POLICE_LICENSE,
	POLICE_LICENSE_ICON,
	POLICE_LICENSE_URL,
} from '../consts';

const today = new Date();
const host = Astro.site?.hostname;
const showBeian = host === 'ryanliu.cn' || host === 'www.ryanliu.cn';
---

<footer>
	<p>&copy; {today.getFullYear()} Ryan Liu. All rights reserved.</p>
	{showBeian && (
		<p class="beian">
			<a href={ICP_LICENSE_URL} target="_blank" rel="noopener noreferrer">{ICP_LICENSE}</a>
			<a href={POLICE_LICENSE_URL} target="_blank" rel="noopener noreferrer">
				<img src={POLICE_LICENSE_ICON} alt="" width="20" />
				{POLICE_LICENSE}
			</a>
		</p>
	)}
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}
	footer p {
		margin: 0;
	}
	.beian {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75em;
		margin-top: 0.75em;
		font-size: 0.75em;
	}
	.beian a {
		display: inline-flex;
		align-items: center;
		gap: 0.25em;
		color: inherit;
		text-decoration: none;
	}
	.beian a:hover {
		text-decoration: underline;
	}
	.beian img {
		display: block;
		width: 20px;
		height: auto;
	}
</style>
