{
  "name": "personal-website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=26",
    "pnpm": ">=12.23.0"
  },
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check && vue-tsc --noEmit",
    "test": "pnpm build && playwright test",
    "test:e2e": "playwright test",
    "format": "prettier --write . --cache",
    "format:check": "prettier --check . --cache",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "lint:css": "stylelint \"src/**/*.{css,vue,astro}\" --cache",
    "lint:md": "markdownlint-cli2",
    "verify:quick": "pnpm format:check && pnpm lint:md && pnpm lint && pnpm lint:css && pnpm build",
    "verify": "pnpm verify:quick && pnpm test:e2e"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.6",
    "@astrojs/vue": "^7.1.6",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@iconify-json/basil": "^1.2.4",
    "@iconify-json/bx": "^1.2.3",
    "@iconify-json/jam": "^1.2.3",
    "@iconify-json/lucide": "^1.2.159",
    "@iconify-json/material-symbols": "^1.2.101",
    "@iconify-json/mingcute": "^1.2.10",
    "@iconify-json/mynaui": "^1.2.20",
    "@iconify-json/simple-icons": "^1.2.104",
    "@iconify/tailwind4": "^1.2.3",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.10",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "katex": "catalog:",
    "markdownlint-cli2": "^0.24.2",
    "postcss-html": "^2.0.1",
    "postcss-selector-parser": "catalog:",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "stylelint": "^18.1.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-recommended": "^19.1.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  }
}
